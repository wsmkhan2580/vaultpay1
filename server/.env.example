# ============================================
# VaultPay Financial Core - Environment Variables
# Copy this file to server/.env and fill in real values.
# NEVER commit the real .env file.
# ============================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
MONGODB_URI=

# --- JWT ---
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- AWS S3 (optional; falls back to local disk storage if unset) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=vaultpay-receipts

# --- SMTP / Email ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=replace-me
SMTP_FROM="VaultPay Financial Core <billing@nexuscorporateservices.com>"

# --- URLs ---
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# --- Rate limiting ---
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
